# Copy to .env and fill in what you need; .env is git-ignored. Never commit a real key.
#
# A local run (IDE, mvn spring-boot:run) reads .env from the working directory, which must be this repository.
# In Docker, pass the variables to the container instead; the image never contains .env.
#
# Leave a line commented out to keep its default: an empty value is used as an empty string, not as the default.

# Anthropic API key. Without it, recommendations come from the topic-match baseline (engine: baseline).
ANTHROPIC_API_KEY=
AMNEZIA_XRAY_CONFIGURATION=

# The LLM ranker
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_TIMEOUT=45s

# The services recommendation-service reads from; the defaults are the compose service names
# PROFILE_SERVICE_URL=http://profile-service:8080
# CATALOG_SERVICE_URL=http://catalog-service:8080
# METRIC_SERVICE_URL=http://metric-service:8080

# Materials in one list
# RECOMMENDATION_ITEMS=6

# Percent of users in the llm variant of the A/B test; the others get the baseline
# AB_LLM_SHARE=100
